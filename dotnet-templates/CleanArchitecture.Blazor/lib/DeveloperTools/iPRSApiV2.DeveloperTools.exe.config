<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8.1" />
  </startup>
  <appSettings>
    <!-- Copy ApiAuth:* and App:Key values from iPRSApiV2.Api\Web.config for configured secrets/keys. -->
    <add key="ApiAuth:Enabled" value="true" />
    <add key="ApiAuth:MaxClockSkewSeconds" value="300" />
    <add key="ApiAuth:Nsrc:SharedSecret" value="" />
    <add key="ApiAuth:Sample:SharedSecret" value="" />
    <add key="App:Key" value="" />
  </appSettings>
</configuration>
