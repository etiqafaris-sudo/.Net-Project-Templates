@page "/settings/portalmenus"
@using Radzen
@using Radzen.Blazor
@inherits AppComponentBase<GLPortalMenuDto>
@inject DialogService DialogService

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Portal Menus</h3>
    <div class="d-flex gap-2">
        <RadzenTextBox Placeholder="@L.GetLangValue("lbl_search")" @bind-Value="searchText" @oninput="OnSearch" style="width: 300px;" />
        <RadzenButton Icon="add" Text="Add Menu" ButtonStyle="ButtonStyle.Primary" Click="@AddMenu" />
    </div>
</div>

<RadzenDataGrid Data="@menus" TItem="GLPortalMenuDto" ColumnWidth="150px" AllowFiltering="false" AllowPaging="true" PageSize="10" HidePagingIfTotalIsLessThenPageSize="false" ShowPagingSummary="true" PagingSummaryFormat="@L.GetLangValue("lbl_paging_summary")" AllowSorting="true">
    <Columns>
        <RadzenDataGridColumn TItem="GLPortalMenuDto" Title="No." Width="70px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
            <Template Context="menu">
                @(menus.ToList().IndexOf(menu) + 1)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="GLPortalMenuDto" Property="MenuName" Title="Menu Name">
             <Template Context="menu">
                 <div style="@(menu.ParentId != null && menu.ParentId > 0 ? "margin-left: 30px; border-left: 2px solid #ccc; padding-left: 10px;" : "font-weight: 600;")">
                     @if(menu.MenuName != null && menu.MenuName.StartsWith("lbl_")) 
                     {
                         @L.GetLangValue(menu.MenuName)
                     }
                     else
                     {
                         @menu.MenuName
                     }
                 </div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="GLPortalMenuDto" Property="MenuUrl" Title="Menu URL" />
        <RadzenDataGridColumn TItem="GLPortalMenuDto" Property="Icon" Title="Icon" Width="100px">
            <Template Context="menu">
                <i class="@menu.Icon"></i> @menu.Icon
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="GLPortalMenuDto" Property="OrderNo" Title="Order" Width="80px" />
        @* <RadzenDataGridColumn TItem="GLPortalMenuDto" Property="ParentId" Title="Parent ID" Width="100px" /> *@
        <RadzenDataGridColumn TItem="GLPortalMenuDto" Property="IsActive" Title="@L.GetLangValue("lbl_col_active")" Width="100px">
            <Template Context="menu">
                @(menu.IsActive == 1 ? @L.GetLangValue("lbl_active_yes") : @L.GetLangValue("lbl_active_no"))
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="GLPortalMenuDto" Sortable="false" Filterable="false" Title="Actions" Width="160px" TextAlign="TextAlign.Center">
            <Template Context="menu">
                <RadzenButton Icon="@(menu.IsActive == 1 ? "block" : "check_circle")" 
                              ButtonStyle="@(menu.IsActive == 1 ? ButtonStyle.Warning : ButtonStyle.Success)" 
                              Variant="Variant.Flat" Size="ButtonSize.Medium" 
                              Click="@(args => ToggleMenuStatus(menu))" @onclick:stopPropagation="true" class="mx-1" 
                              title="@(menu.IsActive == 1 ? L.GetLangValue("lbl_btn_deactivate") : L.GetLangValue("lbl_btn_activate"))"/>
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@(args => EditMenu(menu))" @onclick:stopPropagation="true" class="mx-1" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@(args => DeleteMenu(menu))" @onclick:stopPropagation="true" class="mx-1" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    
}
