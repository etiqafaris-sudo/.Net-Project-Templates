@page "/settings/usergroups"
@using CompanyName.Web.Models.Users
@using Radzen
@using Radzen.Blazor
@inherits AppComponentBase<GlUserGroupDto>
@inject DialogService DialogService

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>User Groups</h3>
    <div class="d-flex gap-2">
        <RadzenTextBox Placeholder="@L.GetLangValue("lbl_search")" @bind-Value="searchText" @oninput="OnSearch" style="width: 300px;" />
        <RadzenButton Icon="add" Text="Add Group" ButtonStyle="ButtonStyle.Primary" Click="@AddGroup" />
    </div>
</div>

<RadzenDataGrid Data="@groups" TItem="GlUserGroupDto" ColumnWidth="150px" AllowFiltering="false" AllowPaging="true" PageSize="10" HidePagingIfTotalIsLessThenPageSize="false" ShowPagingSummary="true" PagingSummaryFormat="@L.GetLangValue("lbl_paging_summary")" AllowSorting="true">
    <Columns>
        <RadzenDataGridColumn TItem="GlUserGroupDto" Title="No." Width="70px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
            <Template Context="group">
                @(groups.ToList().IndexOf(group) + 1)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="GlUserGroupDto" Property="GroupCode" Title="Group Code" Width="150px" />
        <RadzenDataGridColumn TItem="GlUserGroupDto" Property="GroupName" Title="Group Name" />
        <RadzenDataGridColumn TItem="GlUserGroupDto" Property="IsActive" Title="@L.GetLangValue("lbl_col_active")" Width="100px">
            <Template Context="group">
                @(group.IsActive == 1 ? @L.GetLangValue("lbl_active_yes") : @L.GetLangValue("lbl_active_no"))
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="GlUserGroupDto" Sortable="false" Filterable="false" Title="Actions" Width="180px" TextAlign="TextAlign.Center">
            <Template Context="group">
                <RadzenButton Icon="people" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@(args => AssignUsers(group))" @onclick:stopPropagation="true" class="mx-1" title="Assign Users" />
                <RadzenButton Icon="list" ButtonStyle="ButtonStyle.Info" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@(args => ManageMenus(group))" @onclick:stopPropagation="true" class="mx-1" title="Manage Menus" />
                <RadzenButton Icon="@(group.IsActive == 1 ? "block" : "check_circle")" 
                              ButtonStyle="@(group.IsActive == 1 ? ButtonStyle.Warning : ButtonStyle.Success)" 
                              Variant="Variant.Flat" Size="ButtonSize.Medium" 
                              Click="@(args => ToggleGroupStatus(group))" @onclick:stopPropagation="true" class="mx-1" 
                              title="@(group.IsActive == 1 ? L.GetLangValue("lbl_btn_deactivate") : L.GetLangValue("lbl_btn_activate"))"/>
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@(args => EditGroup(group))" @onclick:stopPropagation="true" class="mx-1" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@(args => DeleteGroup(group))" @onclick:stopPropagation="true" class="mx-1" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

