@page "/settings/users"
@using CompanyName.Web.Models.Users
@using Radzen
@using Radzen.Blazor
@inherits AppComponentBase<UserDto>
@inject DialogService DialogService

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@L.GetLangValue("lbl_nav_users")</h3>
    <div class="d-flex gap-2">
        <RadzenTextBox Placeholder="@L.GetLangValue("lbl_search")" @bind-Value="searchText" @oninput="OnSearch" style="width: 300px;" />
        <RadzenButton Icon="add" Text="@L.GetLangValue("lbl_btn_add_user")" ButtonStyle="ButtonStyle.Primary" Click="@AddUser" />
    </div>
</div>

<RadzenDataGrid Data="@users" TItem="UserDto" ColumnWidth="200px" AllowFiltering="false" AllowPaging="true" PageSize="10" HidePagingIfTotalIsLessThenPageSize="false" ShowPagingSummary="true" PagingSummaryFormat="@L.GetLangValue("lbl_paging_summary")" AllowSorting="true">
    <Columns>
        <RadzenDataGridColumn TItem="UserDto" Title="No." Width="60px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
            <Template Context="user">
                @(users.ToList().IndexOf(user) + 1)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="UserDto" Property="Fullname" Title="@L.GetLangValue("lbl_col_fullname")" />
        <RadzenDataGridColumn TItem="UserDto" Property="Email" Title="@L.GetLangValue("lbl_email")" />
        <RadzenDataGridColumn TItem="UserDto" Property="Role" Title="@L.GetLangValue("lbl_col_role")">
            <Template Context="user">
                @{
                    var groupName = GetRoleName(user.Role);
                }
                @if (!string.IsNullOrEmpty(groupName))
                {
                    <span class="badge bg-secondary">@groupName</span>
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="UserDto" Property="IsActive" Title="@L.GetLangValue("lbl_col_active")">
            <Template Context="user">
                @(user.IsActive ? @L.GetLangValue("lbl_active_yes") : @L.GetLangValue("lbl_active_no"))
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="UserDto" Sortable="false" Filterable="false" Title="Actions" Width="160px" TextAlign="TextAlign.Center">
            <Template Context="user">
                <RadzenButton Icon="@(user.IsActive ? "block" : "check_circle")" 
                              ButtonStyle="@(user.IsActive ? ButtonStyle.Warning : ButtonStyle.Success)" 
                              Variant="Variant.Flat" Size="ButtonSize.Medium" 
                              Click="@(args => ToggleUserStatus(user))" @onclick:stopPropagation="true" class="mx-1" 
                              title="@(user.IsActive ? L.GetLangValue("lbl_btn_deactivate") : L.GetLangValue("lbl_btn_activate"))"/>
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@(args => EditUser(user))" @onclick:stopPropagation="true" class="mx-1" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@(args => DeleteUser(user))" @onclick:stopPropagation="true" class="mx-1" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

