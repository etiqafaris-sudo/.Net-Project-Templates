@page "/settings/parameters"
@using CompanyName.Domain.Entities
@using Radzen
@using Radzen.Blazor
@inherits AppComponentBase<GlParameterDescDto>
@inject DialogService DialogService

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@L.GetLangValue("lbl_nav_parameters")</h3>
    <div class="d-flex gap-2">
        <RadzenTextBox Placeholder="@L.GetLangValue("lbl_search")" @bind-Value="searchText" @oninput="OnSearch" style="width: 300px;" />
        <RadzenButton Icon="add" Text="@L.GetLangValue("lbl_btn_add_parameter")" ButtonStyle="ButtonStyle.Primary" Click="@AddParameter" />
    </div>
</div>

<RadzenDataGrid Data="@parameters" TItem="GlParameterDescDto" ColumnWidth="200px" AllowFiltering="false" AllowPaging="true" PageSize="10" HidePagingIfTotalIsLessThenPageSize="false" ShowPagingSummary="true" PagingSummaryFormat="@L.GetLangValue("lbl_paging_summary")" AllowSorting="true">
    <Columns>
        <RadzenDataGridColumn TItem="GlParameterDescDto" Title="No." Width="80px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
            <Template Context="param">
                @(parameters.ToList().IndexOf(param) + 1)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="GlParameterDescDto" Property="ParameterId" Title="@L.GetLangValue("lbl_col_param_id")" Width="150px" Visible="false" />
        <RadzenDataGridColumn TItem="GlParameterDescDto" Property="ParameterDescription" Title="@L.GetLangValue("lbl_col_description")" />
        <RadzenDataGridColumn TItem="GlParameterDescDto" Property="Sort" Title="@L.GetLangValue("lbl_col_sort")" Width="100px" />
        <RadzenDataGridColumn TItem="GlParameterDescDto" Property="IsActive" Title="@L.GetLangValue("lbl_col_active")" Width="100px">
            <Template Context="param">
                @(param.IsActive == 1 ? @L.GetLangValue("lbl_active_yes") : @L.GetLangValue("lbl_active_no"))
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="GlParameterDescDto" Sortable="false" Filterable="false" Title="Actions" Width="160px" TextAlign="TextAlign.Center">
            <Template Context="param">
                <RadzenButton Icon="@(param.IsActive == 1 ? "block" : "check_circle")" 
                              ButtonStyle="@(param.IsActive == 1 ? ButtonStyle.Warning : ButtonStyle.Success)" 
                              Variant="Variant.Flat" Size="ButtonSize.Medium" 
                              Click="@(args => ToggleParameterStatus(param))" @onclick:stopPropagation="true" class="mx-1" 
                              title="@(param.IsActive == 1 ? L.GetLangValue("lbl_btn_deactivate") : L.GetLangValue("lbl_btn_activate"))"/>
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@(args => EditParameter(param))" @onclick:stopPropagation="true" class="mx-1" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@(args => DeleteParameter(param))" @onclick:stopPropagation="true" class="mx-1" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>
