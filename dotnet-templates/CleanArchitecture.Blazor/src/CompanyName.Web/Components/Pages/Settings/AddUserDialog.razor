@using Radzen
@using Radzen.Blazor
@using CompanyName.Web.Models.Users
@inherits AppComponentBase<UserDto>
@inject DialogService DialogService

<RadzenTemplateForm Data="@Model" Submit="@(async (UserDto args) => { await Submit(args); })">
    <div class="row align-items-center mb-3">
        <div class="col-md-3">
            <RadzenLabel Text="@L.GetLangValue("lbl_col_fullname")" />
        </div>
        <div class="col-md-9">
            <RadzenTextBox style="width: 100%;" Name="Fullname" @bind-Value="Model.Fullname" Required="true" />
            <RadzenRequiredValidator Component="Fullname" Text="@L.GetLangValue("lbl_req_fullname")" Style="display: block; font-size: 0.8rem; margin-top: 4px;" />
        </div>
    </div>
    <div class="row align-items-center mb-3">
        <div class="col-md-3">
            <RadzenLabel Text="@L.GetLangValue("lbl_email")" />
        </div>
        <div class="col-md-9">
            <RadzenTextBox style="width: 100%;" Name="Email" @bind-Value="Model.Email" Required="true" />
            <RadzenRequiredValidator Component="Email" Text="@L.GetLangValue("lbl_req_email")" Style="display: block; font-size: 0.8rem; margin-top: 4px;" />
            <RadzenEmailValidator Component="Email" Text="@L.GetLangValue("lbl_invalid_email")" Style="display: block; font-size: 0.8rem; margin-top: 4px;" />
        </div>
    </div>
    @if (!IsEditMode)
    {
        <div class="row align-items-center mb-3">
            <div class="col-md-3">
                <RadzenLabel Text="@L.GetLangValue("lbl_password")" />
            </div>
            <div class="col-md-9">
                <RadzenPassword style="width: 100%;" Name="Password" @bind-Value="Model.Password" Required="true" />
                <RadzenRequiredValidator Component="Password" Text="@L.GetLangValue("lbl_req_password")" Style="display: block; font-size: 0.8rem; margin-top: 4px;" />
            </div>
        </div>
    }
     <div class="row align-items-center mb-3">
        <div class="col-md-3">
            <RadzenLabel Text="@L.GetLangValue("lbl_col_role")" />
        </div>
        <div class="col-md-9">
            <RadzenDropDown style="width: 100%;" Name="Role" @bind-Value="Model.Role" Data="@roles" TextProperty="Text" ValueProperty="Value" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" />
        </div>
    </div>
    <div class="row justify-content-center">
        <div class="col-md-12 d-flex align-items-end justify-content-center" style="margin-top: 16px;">
            <RadzenButton ButtonType="ButtonType.Submit" Icon="save" Text="@L.GetLangValue("lbl_btn_save")" />
            <RadzenButton ButtonStyle="ButtonStyle.Light" Icon="cancel" style="display: inline-block; margin-left: 10px;" Text="@L.GetLangValue("lbl_btn_cancel")" Click="@Cancel" />
        </div>
    </div>
</RadzenTemplateForm>

