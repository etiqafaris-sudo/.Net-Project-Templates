@using CompanyName.Web.Models.Settings
@using CompanyName.Web.Models.Users
@using Radzen
@using Radzen.Blazor
@inherits AppComponentBase<GlUserGroupMenuDto>

<div class="row mb-3">
    <div class="col-12">
        <RadzenText TextStyle="TextStyle.Subtitle1">Select the portal menus this group can access.</RadzenText>
    </div>
</div>

<div class="row mb-4">
    <div class="col-12">
        @if (allMenus != null)
        {
            <RadzenListBox @bind-Value="selectedMenuIds" Data="@allMenus" TextProperty="MenuName" ValueProperty="Id" Multiple="true" AllowClear="true" Style="width: 100%; height: 300px;">
                <Template>
                    @{
                        var menu = context as GLPortalMenuDto;
                        var text = menu?.MenuName;
                        if (text != null && text.StartsWith("lbl_"))
                        {
                            text = L.GetLangValue(text);
                        }
                    }
                    <div style="@(menu?.ParentId != null && menu.ParentId > 0 ? "margin-left: 30px; border-left: 2px solid #ccc; padding-left: 10px;" : "font-weight: 600;")" class="d-flex align-items-center">
                        <i class="@menu?.Icon me-2"></i>
                        @text
                    </div>
                </Template>
            </RadzenListBox>
        }
        else
        {
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        }
    </div>
</div>

<div class="row">
    <div class="col-md-12 text-right">
        <RadzenButton Click="OnSubmit" Text="Save" Style="width: 120px" class="me-1" ButtonStyle="ButtonStyle.Primary" />
        <RadzenButton Click="@((args) => DialogService.Close(false))" ButtonStyle="ButtonStyle.Light" Text="Cancel" Style="width: 120px" />
    </div>
</div>
