@using CompanyName.Web.Models.Users
@using Radzen
@using Radzen.Blazor
@inherits AppComponentBase<GlUserGroupDto>

<EditForm Model="@Model" OnValidSubmit="OnSubmit">
    <DataAnnotationsValidator />

    <div class="row">
        <div class="col-md-12 mb-3">
            <RadzenLabel Text="Group Code" Component="GroupCode" />
            <RadzenTextBox @bind-Value="Model.GroupCode" id="GroupCode" Style="width: 100%;" />
        </div>

        <div class="col-md-12 mb-3">
            <RadzenLabel Text="Group Name" Component="GroupName" />
            <RadzenTextBox @bind-Value="Model.GroupName" id="GroupName" Style="width: 100%;" />
        </div>

        <div class="col-md-12 mb-3 d-flex align-items-center">
            <RadzenLabel Text="Is Active" Component="IsActiveCheckbox" class="me-2" />
            <RadzenSwitch @bind-Value="IsActiveBool" id="IsActiveCheckbox" />
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-12 text-right">
            <RadzenButton ButtonType="ButtonType.Submit" Text="Save" Style="width: 120px" />
            <RadzenButton Click="@((args) => DialogService.Close(false))" ButtonStyle="ButtonStyle.Light" Text="Cancel" Style="width: 120px" Class="me-1" />
        </div>
    </div>
</EditForm>
