@page "/access-denied"
@inherits AppComponentBase<object>

<RadzenCard class="rz-p-5 rz-shadow-3" Style="max-width: 32rem; margin: 2rem auto;">
    <RadzenStack Gap="1rem" AlignItems="AlignItems.Center">
        <RadzenIcon Icon="block" Style="font-size: 3rem; color: var(--rz-danger);" />
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-mb-0 rz-text-align-center">
            Access denied
        </RadzenText>
        <RadzenText TextStyle="TextStyle.Body1" class="rz-text-secondary-color rz-text-align-center">
            You do not have permission to open this page. Contact your administrator if you need access.
        </RadzenText>
        <RadzenButton Text="Back to dashboard" Icon="home" Click="@GoToDashboard" ButtonStyle="ButtonStyle.Primary" />
    </RadzenStack>
</RadzenCard>

@code {
    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private void GoToDashboard() => Navigation.NavigateTo("/dashboard");
}
