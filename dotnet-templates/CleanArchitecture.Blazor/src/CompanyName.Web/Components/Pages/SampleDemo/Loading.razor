@page "/SampleDemo/Loading"
@using CompanyName.Web.Components.Shared
@inherits AppComponentBase<object>

<PageTitle>Ini Sample Je</PageTitle>

<RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-mb-2">
    @L.GetLangValue("lbl_sample_loading_page_title")
</RadzenText>
<RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-mb-4">
    @L.GetLangValue("lbl_sample_loading_page_subtitle")
</RadzenText>

<RadzenCard class="rz-mb-4">
    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" class="rz-mb-3">
        @L.GetLangValue("lbl_sample_loading_sizes")
    </RadzenText>
    <div class="row g-3">
        <div class="col-md-4">
            <RadzenFieldset Text="Small">
                <AppLoadingIndicator Message="@L.GetLangValue("lbl_loading")"
                                     Size="AppLoadingSize.Small" />
            </RadzenFieldset>
        </div>
        <div class="col-md-4">
            <RadzenFieldset Text="Medium">
                <AppLoadingIndicator Message="@L.GetLangValue("lbl_loading")"
                                     Size="AppLoadingSize.Medium" />
            </RadzenFieldset>
        </div>
        <div class="col-md-4">
            <RadzenFieldset Text="Large">
                <AppLoadingIndicator Message="@L.GetLangValue("lbl_loading")"
                                     Size="AppLoadingSize.Large" />
            </RadzenFieldset>
        </div>
    </div>
</RadzenCard>

<RadzenCard class="rz-mb-4">
    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" class="rz-mb-3">
        @L.GetLangValue("lbl_sample_loading_inline")
    </RadzenText>
    <div class="d-flex align-items-center flex-wrap gap-3">
        <AppLoadingIndicator MessageKey="lbl_attachment_uploading"
                             Size="AppLoadingSize.Small"
                             Centered="false"
                             ShowMessage="false" />
        <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-0">
            @L.GetLangValue("lbl_attachment_uploading")
        </RadzenText>
    </div>
</RadzenCard>

<RadzenCard class="rz-mb-4">
    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" class="rz-mb-3">
        @L.GetLangValue("lbl_sample_loading_page_layout")
    </RadzenText>
    <div class="sample-loading-page-preview">
        <AppLoadingPage MessageKey="lbl_redirecting_to_signin" />
    </div>
</RadzenCard>

<RadzenCard>
    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" class="rz-mb-3">
        @L.GetLangValue("lbl_sample_loading_simulated")
    </RadzenText>
    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap" class="rz-mb-3">
        <RadzenButton Text="@L.GetLangValue("lbl_sample_loading_simulate_btn")"
                      Icon="hourglass_top"
                      ButtonStyle="ButtonStyle.Primary"
                      Disabled="@IsLoading"
                      Click="@SimulateLoadAsync" />
        @if (_simulationComplete && !IsLoading)
        {
            <RadzenBadge Text="@L.GetLangValue("lbl_sample_loading_simulate_done")"
                         BadgeStyle="BadgeStyle.Success"
                         Variant="Variant.Outlined" />
        }
    </RadzenStack>

    @if (_simulationComplete)
    {
        <RadzenAlert AlertStyle="AlertStyle.Success"
                     Variant="Variant.Flat"
                     Shade="Shade.Lighter"
                     AllowClose="false"
                     class="rz-mb-0">
            @L.GetLangValue("lbl_sample_loading_simulate_result")
        </RadzenAlert>
    }
</RadzenCard>
