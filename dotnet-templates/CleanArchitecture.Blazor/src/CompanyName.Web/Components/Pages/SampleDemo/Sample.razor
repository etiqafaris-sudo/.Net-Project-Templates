@page "/SampleDemo/"
@page "/SampleDemo/Sample"
@inherits AppComponentBase<DbFactorySampleQueryResponse>

<PageTitle>Sample Only</PageTitle>

<div class="d-flex justify-content-end mb-3">
    <RadzenButton Icon="add" Text="@L.GetLangValue("lbl_btn_add_user")" ButtonStyle="ButtonStyle.Primary" Click="@OpenAddUserDialog" />
</div>


<RadzenDataGrid Data="@_users" TItem="DbFactorySampleQueryResponse" ColumnWidth="200px"
                AllowFiltering="true" AllowPaging="true" PageSize="10"
                HidePagingIfTotalIsLessThenPageSize="false" ShowPagingSummary="true"
                PagingSummaryFormat="@L.GetLangValue("lbl_paging_summary")" AllowSorting="true"
                class="mt-4">
    <Columns>
        <RadzenDataGridColumn TItem="DbFactorySampleQueryResponse" Title="No." Width="60px"
                              TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
            <Template Context="user">
                @(_users!.ToList().IndexOf(user) + 1)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="DbFactorySampleQueryResponse" Property="FullName"
                              Title="@L.GetLangValue("lbl_col_fullname")" />
        <RadzenDataGridColumn TItem="DbFactorySampleQueryResponse" Property="Email"
                              Title="@L.GetLangValue("lbl_email")" />
        <RadzenDataGridColumn TItem="DbFactorySampleQueryResponse" Sortable="false" Filterable="false"
                              Title="Actions" Width="120px" TextAlign="TextAlign.Center">
            <Template Context="user">
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                              Size="ButtonSize.Medium" Click="@(_ => EditUser(user))"
                              @onclick:stopPropagation="true" class="mx-1" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat"
                              Size="ButtonSize.Medium" Click="@(_ => DeleteUser(user))"
                              @onclick:stopPropagation="true" class="mx-1" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

<hr class="my-4" />

<section class="mt-3">
    <h4 class="mb-2">@L.GetLangValue("lbl_sample_attachments_heading")</h4>
    <p class="text-muted mb-3">@L.GetLangValue("lbl_sample_attachments_hint")</p>

    <div class="row mb-3">
        <div class="col-md-4">
            <RadzenLabel Text="@L.GetLangValue("lbl_sample_attachments_record")" />
        </div>
        <div class="col-md-8">
            <RadzenDropDown TValue="int?"
                            Data="@_users"
                            TextProperty="FullName"
                            ValueProperty="user_id"
                            Placeholder="@L.GetLangValue("lbl_dropdown_select")"
                            AllowClear="true"
                            style="width: 100%;"
                            @bind-Value="_selectedUserIdForAttachments" />
        </div>
    </div>

    <AttachmentUpload AppDocId="@(_selectedUserIdForAttachments ?? 0)"
                      OnAttachmentsChanged="OnAttachmentsChanged" />
</section>