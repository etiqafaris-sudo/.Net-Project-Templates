@inject NavigationManager Navigation
@inject BrowserNavigationService BrowserNavigation

<AppLoadingPage MessageKey="lbl_redirecting_to_signin" />

@code {
    private string _loginUrl = "/login";

    protected override void OnInitialized()
    {
        var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (!string.IsNullOrEmpty(returnUrl) && !returnUrl.Equals("login", StringComparison.OrdinalIgnoreCase))
        {
            _loginUrl = $"/login?returnUrl={Uri.EscapeDataString(returnUrl)}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await BrowserNavigation.ForceNavigateAsync(_loginUrl);
        }
    }
}
