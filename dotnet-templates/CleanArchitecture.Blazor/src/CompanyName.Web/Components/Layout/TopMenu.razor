@inherits LayoutComponentBase
@implements IDisposable

<div class="top-menu w-100">
    <RadzenTextBox class="top-menu__search" Placeholder="@L.GetLangValue("lbl_search")" @bind-Value="searchText" @oninput="OnSearch" />
    <div class="top-menu__actions d-flex align-items-center justify-content-end gap-3">
        <RadzenIcon Icon="chat_bubble_outline" class="top-menu__icon" Style="cursor: pointer;" />
        <RadzenIcon Icon="notifications_none" class="top-menu__icon" Style="cursor: pointer;" />

        <RadzenProfileMenu class="top-menu__profile" Style="border: none; background: transparent;">
            <Template>
                <div class="d-flex align-items-center">
                    <RadzenGravatar Email="@UserEmail" Style="width: 32px; height: 32px; border-radius: 50%;" />
                    <span class="top-menu__user-label ms-2">@UserDisplayName</span>
                </div>
            </Template>
            <ChildContent>
                <RadzenProfileMenuItem Text="@L.GetLangValue("lbl_update_profile")" Path="profile" Icon="account_circle" />
                <RadzenProfileMenuItem Text="@L.GetLangValue("lbl_settings")" Path="settings" Icon="settings" />
                <RadzenProfileMenuItem Text="@L.GetLangValue("lbl_logout")" Path="logout" Icon="power_settings_new" />
            </ChildContent>
        </RadzenProfileMenu>
    </div>
</div>